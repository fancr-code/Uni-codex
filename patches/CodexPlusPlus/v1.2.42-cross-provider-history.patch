+#[derive(Default)]
+struct ContentCompatibilityRepair {
+    repaired_message_count: usize,
+    original_types: Vec<&'static str>,
+}
+
+fn normalize_chat_message_contents(messages: &mut [Value]) -> ContentCompatibilityRepair {
+    let mut report = ContentCompatibilityRepair::default();
+    for message in messages {
+        let Some(object) = message.as_object_mut() else {
+            continue;
+        };
+        let original = object.get("content").cloned().unwrap_or(Value::Null);
+        let (normalized, repaired) = normalize_chat_content(&original);
+        if repaired {
+            report.repaired_message_count += 1;
+            let original_type = json_value_type(&original);
+            if !report.original_types.contains(&original_type) {
+                report.original_types.push(original_type);
+            }
+        }
+        object.insert("content".to_string(), normalized);
+    }
+    report
+}
+
+fn normalize_chat_content(content: &Value) -> (Value, bool) {
+    match content {
+        Value::String(_) => (content.clone(), false),
+        Value::Array(parts) => {
+            let safe_parts = parts
+                .iter()
+                .filter_map(normalize_chat_part)
+                .collect::<Vec<_>>();
+            let repaired = safe_parts.len() != parts.len()
+                || safe_parts.as_slice() != parts.as_slice();
+            if safe_parts.is_empty() {
+                (Value::String(String::new()), true)
+            } else {
+                (Value::Array(safe_parts), repaired)
+            }
+        }
+        Value::Null => (Value::String(String::new()), true),
+        Value::Bool(value) => (Value::String(value.to_string()), true),
+        Value::Number(value) => (Value::String(value.to_string()), true),
+        Value::Object(_) => (Value::String(extract_compatible_text(content)), true),
+    }
+}
+
+fn normalize_chat_part(part: &Value) -> Option<Value> {
+    let Some(object) = part.as_object() else {
+        let text = extract_compatible_text(part);
+        return (!text.is_empty()).then(|| json!({ "type": "text", "text": text }));
+    };
+    match object.get("type").and_then(Value::as_str) {
+        Some("text") => object
+            .get("text")
+            .and_then(Value::as_str)
+            .filter(|text| !text.is_empty())
+            .map(|text| json!({ "type": "text", "text": text })),
+        Some("image_url") => object.get("image_url").and_then(|image_url| {
+            if image_url.is_string() || image_url.is_object() {
+                Some(json!({ "type": "image_url", "image_url": image_url }))
+            } else {
+                None
+            }
+        }),
+        _ => {
+            let text = extract_compatible_text(part);
+            (!text.is_empty()).then(|| json!({ "type": "text", "text": text }))
+        }
+    }
+}
+
+fn extract_compatible_text(value: &Value) -> String {
+    if let Some(text) = value.as_str() {
+        return text.to_string();
+    }
+    if let Some(object) = value.as_object() {
+        for key in ["text", "content", "output_text", "refusal"] {
+            if let Some(candidate) = object.get(key) {
+                let text = extract_compatible_text(candidate);
+                if !text.trim().is_empty() {
+                    return text;
+                }
+            }
+        }
+        return format!(
+            "[兼容转换的历史内容] {}",
+            serde_json::to_string(value).unwrap_or_else(|_| "{}".to_string())
+        );
+    }
+    if let Some(parts) = value.as_array() {
+        return parts
+            .iter()
+            .map(extract_compatible_text)
+            .filter(|text| !text.trim().is_empty())
+            .collect::<Vec<_>>()
+            .join("\n");
+    }
+    match value {
+        Value::Null => String::new(),
+        Value::Bool(value) => value.to_string(),
+        Value::Number(value) => value.to_string(),
+        Value::String(_) | Value::Array(_) | Value::Object(_) => unreachable!(),
+    }
+}
+
+fn json_value_type(value: &Value) -> &'static str {
+    match value {
+        Value::Null => "null",
+        Value::Bool(_) => "boolean",
+        Value::Number(_) => "number",
+        Value::String(_) => "string",
+        Value::Array(_) => "array",
+        Value::Object(_) => "object",
+    }
+}
