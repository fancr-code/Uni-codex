diff --git a/crates/codex-plus-core/src/compatibility_notice.rs b/crates/codex-plus-core/src/compatibility_notice.rs
new file mode 100644
index 0000000..2042364
--- /dev/null
+++ b/crates/codex-plus-core/src/compatibility_notice.rs
@@ -0,0 +1,88 @@
+use std::io;
+use std::path::PathBuf;
+use std::sync::{Mutex, OnceLock};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use serde::{Deserialize, Serialize};
+
+const NOTICE_FILE: &str = "content-compatibility-notice.json";
+
+static NOTICE_IO_LOCK: OnceLock<Mutex<()>> = OnceLock::new();
+static TEST_NOTICE_PATH: OnceLock<Mutex<Option<PathBuf>>> = OnceLock::new();
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ContentRepairNotice {
+    pub repaired_message_count: usize,
+    pub timestamp_ms: u64,
+}
+
+pub fn record_content_repair(repaired_message_count: usize) -> io::Result<()> {
+    if repaired_message_count == 0 {
+        return Ok(());
+    }
+
+    let _guard = notice_io_lock()?;
+    let path = notice_path();
+    if let Some(parent) = path.parent() {
+        std::fs::create_dir_all(parent)?;
+    }
+    let previous_count = match std::fs::read(&path) {
+        Ok(bytes) => serde_json::from_slice::<ContentRepairNotice>(&bytes)
+            .map(|notice| notice.repaired_message_count)
+            .unwrap_or(0),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => 0,
+        Err(error) => return Err(error),
+    };
+    let notice = ContentRepairNotice {
+        repaired_message_count: previous_count.saturating_add(repaired_message_count),
+        timestamp_ms: now_ms(),
+    };
+    let bytes = serde_json::to_vec(&notice)
+        .map_err(|error| io::Error::new(io::ErrorKind::InvalidData, error))?;
+    crate::settings::atomic_write(&path, &bytes).map_err(io::Error::other)
+}
+
+pub fn take_content_repair_notice() -> io::Result<Option<ContentRepairNotice>> {
+    let _guard = notice_io_lock()?;
+    let path = notice_path();
+    let bytes = match std::fs::read(&path) {
+        Ok(bytes) => bytes,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(None),
+        Err(error) => return Err(error),
+    };
+    let notice = serde_json::from_slice(&bytes)
+        .map_err(|error| io::Error::new(io::ErrorKind::InvalidData, error))?;
+    std::fs::remove_file(path)?;
+    Ok(Some(notice))
+}
+
+fn notice_path() -> PathBuf {
+    if let Ok(guard) = TEST_NOTICE_PATH.get_or_init(|| Mutex::new(None)).lock() {
+        if let Some(path) = &*guard {
+            return path.clone();
+        }
+    }
+    crate::paths::default_app_state_dir().join(NOTICE_FILE)
+}
+
+fn notice_io_lock() -> io::Result<std::sync::MutexGuard<'static, ()>> {
+    NOTICE_IO_LOCK
+        .get_or_init(|| Mutex::new(()))
+        .lock()
+        .map_err(|_| io::Error::other("compatibility notice lock poisoned"))
+}
+
+fn now_ms() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_millis() as u64
+}
+
+#[doc(hidden)]
+pub fn set_notice_path_for_tests(path: Option<PathBuf>) {
+    if let Ok(mut guard) = TEST_NOTICE_PATH.get_or_init(|| Mutex::new(None)).lock() {
+        *guard = path;
+    }
+}
